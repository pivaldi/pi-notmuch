## Note : OVYA Notmuch configuration set the tag "new" to all new message.

# +ovya.fr -- tag:new AND (DeliveredTo:@ovya.fr OR 'from:"/.*@ovya.fr/"')
+inbox +ovya.fr -- folder:"ovya.fr/inbox" AND NOT (tag:archived OR tag:spam OR tag:delete OR tag:deleted OR tag:expire)
-inbox +spam +ovya.fr -- folder:"ovya.fr/spam"
-unread -inbox -delete -archived +deleted +ovya.fr -- (NOT tag:deleted) AND folder:"ovya.fr/trash"
-inbox +sent +ovya.fr -- folder:"ovya.fr/sent"
+archived +ovya.fr -- folder:"ovya.fr/all" AND (NOT tag:unread) AND (NOT tag:inbox) AND (NOT tag:sent) AND (NOT folder:"ovya.fr/trash") AND (NOT tag:spam)
## Only on new messages, so a manual unread/unflag is not undone at the next sync.
-unread -- tag:new AND (folder:"ovya.fr/spam" OR folder:"ovya.fr/sent")
+flagged +ovya.fr -- tag:new AND folder:"ovya.fr/starred"
+igal +ovya.fr -- (from:"/.* inatan@/" OR to:"/.* inatan@/")
+stanley +ovya.fr -- (from:"/.* snahon@/" OR to:"/.* snahon@/")

-inbox +redmine +ovya.fr -- XMailer:Redmine
-inbox +ovya.fr +cpro -- XRedmineProject:cpro
-inbox +ovya.fr +csite -- XRedmineProject:rcv_site
-inbox +ovya.fr +admin +archived -- (to:"/.* admin@.*/" OR to:"/.* adminsys@.*/" OR ListID:admin.ovya.fr)
-inbox +cron +archived -- subject:Cron
-unread -- tag:new AND (to:"/.* admin@.*/" OR to:"/.* adminsys@.*/" OR ListID:admin.ovya.fr OR subject:Cron)

