# Sync the movement of messages between folders and deletions
# ADD THIS AFTER MAKING SURE THE SYNC WORKS
Expunge Both
# Expunge None
Create Both
# Save the synchronization state files in the relevant directory
SyncState *
CopyArrivalDate yes
# PipelineDepth 10

#### ivaldi.me ACCOUNT #####

MaildirStore ivaldi.me-local
SubFolders Verbatim
## Remember to create this directory : mkdir -p ~/Mail/ivaldi.me
Path ~/Mail/ivaldi.me/
Inbox ~/Mail/ivaldi.me/inbox

IMAPAccount ivaldi.me-account
Host 127.0.0.1
UserCmd "gpg -q --for-your-eyes-only -d ~/.authinfo.gpg | awk -F ' ' '/127.0.0.1/ { print $(NF-4); exit; }'"
PassCmd "gpg -q --for-your-eyes-only -d ~/.authinfo.gpg | awk -F ' ' '/127.0.0.1/ { print $(NF-2); exit; }'"
Port 1143
TLSType STARTTLS
CertificateFile /etc/ssl/certs/proton-bridge.pem

IMAPStore ivaldi.me-remote
Account ivaldi.me-account

Channel ivaldi.me-inbox
Far :ivaldi.me-remote:
Near :ivaldi.me-local:
Patterns "INBOX"

Channel ivaldi.me-sent
Far :ivaldi.me-remote:"Sent"
Near :ivaldi.me-local:sent

Channel ivaldi.me-archive
Far :ivaldi.me-remote:"Archive"
Near :ivaldi.me-local:archive

Channel ivaldi.me-trash
Far :ivaldi.me-remote:"Trash"
Near :ivaldi.me-local:trash

Channel ivaldi.me-starred
Far :ivaldi.me-remote:"Starred"
Near :ivaldi.me-local:starred

Channel ivaldi.me-spam
Far :ivaldi.me-remote:"Spam"
Near :ivaldi.me-local:spam

Group ivaldi.me
Channel ivaldi.me-inbox
Channel ivaldi.me-sent
Channel ivaldi.me-archive
Channel ivaldi.me-starred
Channel ivaldi.me-spam
Channel ivaldi.me-trash

