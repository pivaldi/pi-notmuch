#### OVYA ACCOUNT #####

MaildirStore ovya.fr-local
SubFolders Verbatim
## Remember to create this directory : mkdir -p ~/Mail/ovya.fr
Path ~/Mail/ovya.fr/
Inbox ~/Mail/ovya.fr/inbox

IMAPAccount ovya.fr-account
Host imap.gmail.com
UserCmd "pass mbsync.ovya.fr | grep 'login:' | awk '{print $2}'"
PassCmd "pass mbsync.ovya.fr | head -1"
Port 993
AuthMechs LOGIN
TLSType IMAPS
CertificateFile /etc/ssl/certs/ca-certificates.crt

IMAPStore ovya.fr-remote
Account ovya.fr-account

Channel ovya.fr-inbox
Far :ovya.fr-remote:
Near :ovya.fr-local:
Patterns "INBOX"

Channel ovya.fr-sent
Far :ovya.fr-remote:"[Gmail]/Sent Mail"
Near :ovya.fr-local:sent

Channel ovya.fr-trash
Far :ovya.fr-remote:"[Gmail]/Trash"
Near :ovya.fr-local:trash

# Channel ovya.fr-all
# Far :ovya.fr-remote:"[Gmail]/All Mail"
# Near :ovya.fr-local:all

Channel ovya.fr-starred
Far :ovya.fr-remote:"[Gmail]/Starred"
Near :ovya.fr-local:starred

Channel ovya.fr-spam
Far :ovya.fr-remote:"[Gmail]/Spam"
Near :ovya.fr-local:spam

Group ovya.fr
Channel ovya.fr-inbox
Channel ovya.fr-sent
# Channel ovya.fr-all
Channel ovya.fr-starred
Channel ovya.fr-spam
Channel ovya.fr-trash
